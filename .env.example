# Plantilla de configuración de QuantLab (copiar a `.env`; `.env` no se versiona).
# Valores por defecto alineados con specs/002-migration-foundation/quickstart.md.
# OJO: todavía ningún módulo lee estas variables; las consumirá `settings.py` (T001).

# Interfaz y puerto locales (no exponer sin autenticación).
QUANTLAB_HOST=127.0.0.1
QUANTLAB_PORT=8050
QUANTLAB_DEBUG=0

# Endpoints públicos de Deriv, en orden de prioridad (separados por comas).
# Sólo lectura de datos de mercado: sin tokens, sin cuenta, sin trading.
# El fallback se usa únicamente si falla el transporte del primero.
QUANTLAB_DERIV_ENDPOINTS=wss://api.derivws.com/trading/v1/options/ws/public,wss://ws.binaryws.com/websockets/v3?app_id=1089

# Límite global de peticiones a Deriv por minuto (token bucket propio).
QUANTLAB_RATE_LIMIT_PER_MIN=150

# Presupuesto de RAM (sólo memoria: no se persiste nada en disco).
QUANTLAB_MAX_TICKS=50000
QUANTLAB_MAX_CANDLES_PER_TF=30000
QUANTLAB_RAM_WARNING_MB=380
QUANTLAB_RAM_CRITICAL_MB=420

# Refresco de métricas ligeras y antigüedad máxima tolerada de los datos.
QUANTLAB_REFRESH_SECONDS=60
QUANTLAB_STALE_SECONDS=900

# Semilla de simulaciones/bootstrap y nivel de log (sólo consola).
QUANTLAB_SEED=20261115
QUANTLAB_LOG_LEVEL=INFO
