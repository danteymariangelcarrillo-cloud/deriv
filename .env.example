# Endpoint público de Deriv WebSocket (sin token, sin secretos).
QUANTLAB_WS_URL=wss://ws.derivws.com/websockets/v3?app_id=1089

# Límite global de peticiones a Deriv por minuto (token bucket).
QUANTLAB_RATE_LIMIT_PER_MIN=150

# Presupuesto de RAM del proceso en MB.
QUANTLAB_MAX_RAM_MB=400

# Antigüedad máxima tolerada de los datos, en segundos.
QUANTLAB_STALE_SECONDS=900

# 1 = operar contra cuenta demo; 0 = cuenta real.
QUANTLAB_DEMO=0
